      "name": "1. View Offers List (GET)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/restaurant/pos/offers?lang=ar&page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "restaurant",
            "pos",
            "offers"
          ],
          "query": [
            {
              "key": "lang",
              "value": "ar",
              "description": "اللغة (ar, en, fr)"
            },
            {
              "key": "page",
              "value": "1",
              "description": "رقم الصفحة"
            },
            {
              "key": "limit",
              "value": "10",
              "description": "عدد العناصر"
            },
            {
              "key": "search",
              "value": "",
              "disabled": true,
              "description": "بحث بالاسم"
            },
            {
              "key": "all",
              "value": "false",
              "disabled": true,
              "description": "جلب الكل بدون تقسيم صفحات"
            }
          ]
        },
        "description": "عرض قائمة الوجبات التي لديها عرض ساري فقط (where offer_price IS NOT NULL) لنفس المطعم."
      },
      "response": [
        {
          "name": "Success Response",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
