          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"message\": \"Offers fetched successfully\",\n    \"data\": [\n      {\n        \"foodId\": \"a830113f-8cae-4f76-928d-1941d4021234\",\n        \"id\": \"a830113f-8cae-4f76-928d-1941d4021234\",\n        \"name\": \"برجر كيتو دجاج\",\n        \"offer_price\": \"45.00\",\n        \"offer_days\": [\n          \"sunday\",\n          \"monday\",\n          \"thursday\"\n        ],\n        \"offer_start\": \"12:00:00\",\n        \"offer_end\": \"22:00:00\"\n      }\n    ],\n    \"pagination\": {\n      \"page\": 1,\n      \"limit\": 10,\n      \"totalItems\": 1,\n      \"totalPages\": 1\n    }\n  }\n}"
